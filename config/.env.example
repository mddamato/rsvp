# ===== Central configuration =====
# Copy this file to config/.env on the server and fill in real values.
# config/.env is gitignored and never committed.

# Domain the app is served on (used by nginx, certbot, QR links, emails)
DOMAIN_NAME=yourdomain.com

# Flask session signing key. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme

# Database (postgres image reads POSTGRES_*, app reads the same values)
POSTGRES_USER=rsvp_app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=rsvp
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# TLS: "letsencrypt" (default, via scripts/init-letsencrypt.sh) or
# "cloudflare" (Cloudflare Origin Certificate, requires Full (strict)
# mode and config/cloudflare_origin_server.crt/.key)
TLS_MODE=letsencrypt

# AWS
AWS_REGION=us-east-1
SES_SENDER_EMAIL=noreply@yourdomain.com
BACKUP_S3_BUCKET=your-backup-bucket-name

# Admin auth file inside the app container (mounted from config/htpasswd)
HTPASSWD_PATH=/etc/rsvp/.htpasswd

# Guest-facing page text. All optional except EVENT_TITLE has a default.
EVENT_TITLE=Our Celebration
EVENT_SUBHEADING=Saturday, June 5, 2027 at 4:00 PM
EVENT_DETAILS=Join us at the Riverside Pavilion. Parking is available in Lot B; please arrive 15 minutes early for seating.
EVENT_CLOSING=- The Smith Family

# Optional: an invitation image shown under EVENT_DETAILS on every
# guest-facing page (never on admin pages). Value is a filename inside
# config/assets/ (not a full path -- e.g. "invite.png", not
# "config/assets/invite.png"). Resized server-side to fit mobile
# (capped at 1200px wide, original aspect ratio kept) the first time
# it's requested, then cached for the life of the process. Leave blank
# (default) to show no image. See "Non-secret config assets" in
# README for how to get the file itself onto the server.
EVENT_DETAILS_IMAGE=

# Optional: a single shared human-typed phrase for un-provisioned
# self-registration (e.g. printed on a general flyer/poster instead of
# a personal card). Matching is case-insensitive, apostrophes are
# ignored, extra whitespace is collapsed. Visitors who type this
# phrase get a self-registration form and are added to the guest list
# immediately (origin=self), flagged for admin review on the
# dashboard. Avoid picking exactly three common dictionary words (to
# keep this from ever coinciding with a generated per-guest passcode).
# Leave blank (default) to disable this feature entirely.
ANONYMOUS_PHRASE=

# Only relevant if ANONYMOUS_PHRASE is set. "1" lets self-registrants
# bring additional guests (same name + child-6-or-under UI as the
# normal RSVP form); unset/"0" (default) restricts self-registration
# to solo sign-ups.
SELF_REGISTER_MULTIPLE_GUESTS=
